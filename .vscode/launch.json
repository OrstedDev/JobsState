{
    "version": "1.0.0",
    "configurations": [
        {
            "name": "Start App",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "env": {
                "BROWSER": "none"
            },
            "console": "integratedTerminal"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Run Chrome",
            "url": "http://localhost:5000/",
            "webRoot": "${workspaceFolder}",
            "sourceMaps": true
        }
    ],
    "compounds": [
        {
            "name": "Debug App",
            "configurations": ["Start App", "Run Chrome"],
            "stopAll": true
        }
    ]
}
